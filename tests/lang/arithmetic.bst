print(1 + 2 * 3)          # expect: 7
print((1 + 2) * 3)        # expect: 9
print(10 / 4)             # expect: 2.5
print(7 % 3)              # expect: 1
print(-7 % 3)             # expect: -1
print(2 * 3 + 4 * 5)      # expect: 26
print(-(3 + 2))           # expect: -5
print(-3 * -4)            # expect: 12
print(1 / 0)              # expect: inf
print(0.1 + 0.2)          # expect: 0.3
print(0.1 + 0.2 == 0.3)   # expect: false
print(1e3 + 1)            # expect: 1001
print(9007199254740992)   # expect: 9007199254740992
print(1e20)               # expect: 1e+20
